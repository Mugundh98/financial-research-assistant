# Copy to .env and fill in. Nothing here is required to RUN the system:
# with no ANTHROPIC_API_KEY the LLM layer automatically falls back to a
# deterministic offline "mock" model, so the full pipeline + evals still run.

# ---- LLM ----
# Backend: "anthropic" (default) or "mock". Anthropic auto-falls-back to mock
# if ANTHROPIC_API_KEY is empty.
LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
# Model tiers used by the capability router:
LLM_MODEL_STRONG=claude-sonnet-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001

# ---- SEC EDGAR (real data source) ----
# SEC requires a descriptive contact string in the User-Agent header.
# Put your app name + a real contact (email or URL). Do not commit secrets.
SEC_USER_AGENT=ey-wft-assignment/1.0 (contact: set-your-contact@example.com)

# ---- Access control ----
# Default role for the demo user: viewer | analyst | admin
DEFAULT_ROLE=analyst

# ---- Freshness ----
# Data whose freshest source is older than this many days is flagged stale.
# 400d keeps current-fiscal-year annual (10-K) data fresh; ~2yr-old data flags.
STALENESS_DAYS=400
